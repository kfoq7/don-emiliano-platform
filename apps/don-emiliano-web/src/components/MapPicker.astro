---
interface Props {
  lat?: number
  lng?: number
  name?: string
  height?: string
  zoom?: number
}

// Setting by default the current restaurant
const {
  lat = -11.95118,
  lng = -77.0509283,
  name = 'location',
  height = '500px',
  zoom = 17,
} = Astro.props
---

<div
  id="map-container"
  class="map-picker-container w-full px-8 flex flex-col items-center"
  data-lat={lat}
  data-lng={lng}
  data-zoom={zoom}
>
  <div
    class="mt-4 mx-6 gap-2 flex flex-col md:flex-none items-center w-full max-w-md relative z-1000"
  >
    <div class="w-full relative mb-4">
      <input
        id="location-search"
        aria-label="Search for a location in Lima, Peru"
        type="text"
        placeholder="Buscar dirección en Lima..."
        class="w-full px-3 py-2 border-2 border-gray-300 rounded-lg focus:border-primary/80 focus:outline-none"
      />
      <div
        id="search-results"
        class="hidden absolute z-1000 w-full mt-1 bg-white border-2 border-gray-300 rounded-lg shadow-lg max-h-60 overflow-y-auto"
      >
      </div>
    </div>
  </div>

  <div
    id="map-picker"
    class="map-wrapper rounded-lg overflow-hidden border mx-5 z-9"
    aria-label="Interactive map to get the user location"
    style={`width: 100%; height: ${height};`}
  >
  </div>

  <input aria-hidden="true" type="hidden" name={`${name}-lat`} class="lat-input" value={lat} />
  <input aria-hidden="true" type="hidden" name={`${name}-lng`} class="lng-input" value={lng} />
</div>

<!-- Leaflet CSS -->
<link
  rel="stylesheet"
  href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
  integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
  crossorigin=""
/>

<!-- Leaflet JS -->
<script
  is:inline
  src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
  integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
  crossorigin=""></script>

<script>
  import { location } from '@/stores/location'
  import { debounce } from '@/utils/debounce'

  type SearchResult = { lat: string; lon: string; display_name: string }

  const L = (window as any).L as typeof import('leaflet') | undefined

  // Lima, Peru bounding box (minlon, maxlat, maxlon, minlat)
  const LIMA_VIEWBOX = '-77.2,-11.7,-76.7,-12.3'
  const MIN_QUERY_LENGTH = 3
  // The modal animates in over 300ms; Leaflet must re-measure once it has its final size.
  const MODAL_ANIMATION_MS = 350

  const fixLeafletIcons = () => {
    if (!L) return
    delete (L.Icon.Default.prototype as any)._getIconUrl
    L.Icon.Default.mergeOptions({
      iconUrl: 'https://unpkg.com/leaflet@1.9.4/dist/images/marker-icon.png',
      iconRetinaUrl: 'https://unpkg.com/leaflet@1.9.4/dist/images/marker-icon-2x.png',
      shadowUrl: 'https://unpkg.com/leaflet@1.9.4/dist/images/marker-shadow.png',
    })
  }

  const fetchNominatim = async (query: string, signal: AbortSignal): Promise<SearchResult[]> => {
    const url = new URL('https://nominatim.openstreetmap.org/search')
    url.searchParams.set('q', `${query}, Lima, Peru`)
    url.searchParams.set('format', 'json')
    url.searchParams.set('limit', '5')
    url.searchParams.set('countrycodes', 'pe')
    url.searchParams.set('bounded', '1')
    url.searchParams.set('viewbox', LIMA_VIEWBOX)
    url.searchParams.set('accept-language', 'es')

    const response = await fetch(url, { signal })
    if (!response.ok) throw new Error('Search failed')
    return response.json()
  }

  // Throws AbortError when superseded so callers can ignore stale responses.
  async function searchLocation(query: string, signal: AbortSignal): Promise<SearchResult[]> {
    const results = await fetchNominatim(query, signal)
    if (results.length > 0) return results

    // OSM has little house-number coverage in Lima, so "Jr Huallaga 123" finds nothing
    // while "Jr Huallaga" does. Retry on the street so the user can fine-tune on the map.
    const street = query.replace(/\s+(n[°º.]?\s*)?\d+[a-z]?$/i, '').trim()
    if (street === query || street.length < MIN_QUERY_LENGTH) return results
    return fetchNominatim(street, signal)
  }

  const restaurantIconHtml = `
    <div class="flex items-center justify-center rounded-full bg-action w-8 h-8 shadow-lg">
      <svg height="24px" viewBox="0 -960 960 960" width="24px" fill="white"><path d="M841-518v318q0 33-23.5 56.5T761-120H201q-33 0-56.5-23.5T121-200v-318q-23-21-35.5-54t-.5-72l42-136q8-26 28.5-43t47.5-17h556q27 0 47 16.5t29 43.5l42 136q12 39-.5 71T841-518Zm-272-42q27 0 41-18.5t11-41.5l-22-140h-78v148q0 21 14 36.5t34 15.5Zm-180 0q23 0 37.5-15.5T441-612v-148h-78l-22 140q-4 24 10.5 42t37.5 18Zm-178 0q18 0 31.5-13t16.5-33l22-154h-78l-40 134q-6 20 6.5 43t41.5 23Zm540 0q29 0 42-23t6-43l-42-134h-76l22 154q3 20 16.5 33t31.5 13ZM201-200h560v-282q-5 2-6.5 2H751q-27 0-47.5-9T663-518q-18 18-41 28t-49 10q-27 0-50.5-10T481-518q-17 18-39.5 28T393-480q-29 0-52.5-10T299-518q-21 21-41.5 29.5T211-480h-4.5q-2.5 0-5.5-2v282Zm560 0H201h560Z"/></svg>
    </div>`

  // Shared by the map click handler and the search box, which can be used before the map exists.
  let picker: { map: L.Map; marker: L.Marker; zoom: number } | null = null

  const updateLocation = (container: HTMLElement, lat: number, lng: number) => {
    if (picker) {
      picker.marker.setLatLng([lat, lng])
      picker.map.setView([lat, lng], Math.max(picker.map.getZoom(), picker.zoom))
    }

    const latInput = container.querySelector<HTMLInputElement>('.lat-input')
    const lngInput = container.querySelector<HTMLInputElement>('.lng-input')
    if (latInput) latInput.value = String(lat)
    if (lngInput) lngInput.value = String(lng)

    location.set({ lat: lat.toFixed(6), lng: lng.toFixed(6) })

    container.dispatchEvent(
      new CustomEvent('location-change', {
        detail: { latitude: lat, longitude: lng },
        bubbles: true,
      }),
    )
  }

  const initializeMap = (container: HTMLElement) => {
    const wrapper = container.querySelector<HTMLElement>('#map-picker')
    if (!wrapper || !L) return

    // Re-opening the modal: the map exists, it only needs to re-measure its container.
    if (picker) {
      const { map } = picker
      setTimeout(() => map.invalidateSize(), MODAL_ANIMATION_MS)
      return
    }

    const restaurantLat = parseFloat(container.dataset.lat ?? '')
    const restaurantLng = parseFloat(container.dataset.lng ?? '')
    const zoom = parseInt(container.dataset.zoom ?? '', 10) || 17
    if (Number.isNaN(restaurantLat) || Number.isNaN(restaurantLng)) return

    // Resume from a previously confirmed location, otherwise start at the restaurant.
    const saved = location.get()
    const startLat = saved ? parseFloat(saved.lat) : restaurantLat
    const startLng = saved ? parseFloat(saved.lng) : restaurantLng

    try {
      const map = L.map(wrapper).setView([startLat, startLng], zoom)
      map.attributionControl.setPrefix('')

      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution:
          '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
        maxZoom: 19,
      }).addTo(map)

      L.marker([restaurantLat, restaurantLng], {
        icon: L.divIcon({
          html: restaurantIconHtml,
          iconSize: [40, 40],
          iconAnchor: [20, 20],
          className: 'restaurant-icon-marker',
        }),
        interactive: false,
        keyboard: false,
      }).addTo(map)

      const marker = L.marker([startLat, startLng]).addTo(map)
      picker = { map, marker, zoom }

      map.on('click', (e: L.LeafletMouseEvent) =>
        updateLocation(container, e.latlng.lat, e.latlng.lng),
      )
      setTimeout(() => map.invalidateSize(), MODAL_ANIMATION_MS)
    } catch (error) {
      console.error('Error initializing map:', error)
    }
  }

  // Wired at page load, not on map init, so a map failure can't take the search down with it.
  const setupSearch = (container: HTMLElement) => {
    const searchInput = container.querySelector<HTMLInputElement>('#location-search')
    const searchResults = container.querySelector<HTMLDivElement>('#search-results')
    if (!searchInput || !searchResults) return

    // Results are built with DOM APIs (not innerHTML): display names come from a third party.
    const showMessage = (text: string) => {
      const message = document.createElement('div')
      message.className = 'p-3 text-gray-500 text-sm'
      message.textContent = text
      searchResults.replaceChildren(message)
      searchResults.classList.remove('hidden')
    }

    const hideResults = () => searchResults.classList.add('hidden')

    const renderResults = (results: SearchResult[]) => {
      if (results.length === 0) return showMessage('No se encontraron resultados')

      const items = results.map(result => {
        const button = document.createElement('button')
        button.type = 'button'
        button.className =
          'w-full text-left p-3 hover:bg-gray-100 border-b last:border-b-0 transition-colors cursor-pointer text-sm font-medium'
        button.textContent = result.display_name
        button.addEventListener('click', () => {
          updateLocation(container, parseFloat(result.lat), parseFloat(result.lon))
          searchInput.value = result.display_name
          hideResults()
        })
        return button
      })
      searchResults.replaceChildren(...items)
      searchResults.classList.remove('hidden')
    }

    let currentRequest: AbortController | null = null

    const runSearch = async (query: string) => {
      currentRequest?.abort()
      const request = new AbortController()
      currentRequest = request

      showMessage('Buscando...')
      try {
        renderResults(await searchLocation(query, request.signal))
      } catch (error) {
        if ((error as Error).name === 'AbortError') return
        console.error('Error searching location:', error)
        showMessage('No se pudo buscar la dirección. Intenta de nuevo.')
      }
    }

    const debouncedSearch = debounce(runSearch, 500)

    searchInput.addEventListener('input', () => {
      const query = searchInput.value.trim()
      if (query.length >= MIN_QUERY_LENGTH) {
        debouncedSearch(query)
      } else {
        // Invalidate any in-flight request so it can't reopen the list after clearing.
        currentRequest?.abort()
        hideResults()
      }
    })

    searchInput.addEventListener('keydown', e => {
      if (e.key === 'Enter') {
        // Inside a form, Enter would submit it; here it should search right away.
        e.preventDefault()
        const query = searchInput.value.trim()
        if (query.length >= MIN_QUERY_LENGTH) runSearch(query)
      } else if (e.key === 'Escape' && !searchResults.classList.contains('hidden')) {
        // Don't let the modal's Escape handler close the whole dialog.
        e.stopPropagation()
        hideResults()
      }
    })

    document.addEventListener('mousedown', e => {
      const target = e.target as Node
      if (!searchInput.contains(target) && !searchResults.contains(target)) hideResults()
    })
  }

  const setup = () => {
    fixLeafletIcons()

    const mapContainer = document.querySelector<HTMLElement>('.map-picker-container')
    if (!mapContainer) return

    setupSearch(mapContainer)

    // The modal is hidden at load, so Leaflet can only measure the container once it opens.
    mapContainer.addEventListener('modal-opened', () => {
      setTimeout(() => initializeMap(mapContainer), 100)
    })
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setup)
  } else {
    setup()
  }
</script>
